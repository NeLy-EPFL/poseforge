#!/bin/bash -l

#SBATCH --job-name simsiam_pretrain_crop256
#SBATCH --nodes 1
#SBATCH --ntasks 1
#SBATCH --cpus-per-task 16
#SBATCH --mem 90GB
#SBATCH --time 72:00:00
#SBATCH --partition=h100
#SBATCH --qos=normal
#SBATCH --gres=gpu:1
#SBATCH --output /home/$USER/poseforge/scripts_on_cluster/simsiam_pretraining_training/output_20260622a_simsiam256.log

echo "Hello from $(hostname)"

. ~/spack/share/spack/setup-env.sh
spack load ffmpeg
conda activate poseforge

cd $HOME/poseforge
echo "Training starting at $(date)"

# Head-to-head with cropped_contrastive_pretraining_training/cropped256.run.
# Same data, same crop, same border-exclude, same n_variants, same
# train_batch_size, same image_size, same n_epochs, same seed. The only
# things that differ from the InfoNCE run are the loss (negative cosine
# similarity with stop-gradient + predictor) and the model (extra
# predictor head). Diagnostic to watch in TensorBoard:
# Diagnostics/ProjectionNorm — if it collapses toward 0, training has
# degenerated to the trivial solution.
trial_name="trial_20260622_simsiam256"
atomic_batch_dir="/work/upramdya/alfie/style_transfer/contrastive_pretraining/atomic_batches/"
out_dir="/scratch/stimpfli/style_transfer/simsiam_pretraining/$trial_name"

python -u src/poseforge/pose/simsiam/scripts/run_simsiam_pretraining.py \
    --n-epochs 10 \
    --seed 42 \
    --simsiam-architecture-config.projection-head-hidden-dim 512 \
    --simsiam-architecture-config.projection-head-output-dim 256 \
    --simsiam-architecture-config.predictor-hidden-dim 128 \
    --model-weights-config.feature-extractor-weights "IMAGENET1K_V1" \
    --training-data-config.train-data-dirs \
        "${atomic_batch_dir}BO_Gal4_fly1_trial003" \
        "${atomic_batch_dir}BO_Gal4_fly1_trial004" \
        "${atomic_batch_dir}BO_Gal4_fly1_trial005" \
        "${atomic_batch_dir}BO_Gal4_fly2_trial001" \
        "${atomic_batch_dir}BO_Gal4_fly2_trial002" \
        "${atomic_batch_dir}BO_Gal4_fly2_trial003" \
        "${atomic_batch_dir}BO_Gal4_fly2_trial004" \
        "${atomic_batch_dir}BO_Gal4_fly2_trial005" \
        "${atomic_batch_dir}BO_Gal4_fly3_trial001" \
        "${atomic_batch_dir}BO_Gal4_fly3_trial002" \
        "${atomic_batch_dir}BO_Gal4_fly3_trial003" \
        "${atomic_batch_dir}BO_Gal4_fly3_trial004" \
        "${atomic_batch_dir}BO_Gal4_fly3_trial005" \
        "${atomic_batch_dir}BO_Gal4_fly4_trial001" \
        "${atomic_batch_dir}BO_Gal4_fly4_trial002" \
        "${atomic_batch_dir}BO_Gal4_fly4_trial003" \
        "${atomic_batch_dir}BO_Gal4_fly4_trial004" \
        "${atomic_batch_dir}BO_Gal4_fly4_trial005" \
    --training-data-config.val-data-dirs \
        "${atomic_batch_dir}BO_Gal4_fly1_trial002" \
    --training-data-config.atomic-batch-n-samples 32 \
    --training-data-config.atomic-batch-n-variants 2 \
    --training-data-config.train-batch-size 256 \
    --training-data-config.val-batch-size 128 \
    --training-data-config.image-size 900 900 \
    --training-data-config.crop-size 256 256 \
    --training-data-config.crop-border-exclude 100 \
    --training-data-config.n-workers 4 \
    --optimizer-config.adam-lr 1e-4 \
    --optimizer-config.adam-weight-decay 1e-4 \
    --training-artifacts-config.output-basedir \
        "$out_dir" \
    --training-artifacts-config.logging-interval 10 \
    --training-artifacts-config.checkpoint-interval 500 \
    --training-artifacts-config.validation-interval 200 \
    --training-artifacts-config.n-batches-per-validation 100

echo "Training ends at $(date)"
