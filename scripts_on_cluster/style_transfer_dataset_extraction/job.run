#!/bin/bash -l

#SBATCH --job-name st_dataset_extraction
#SBATCH --nodes 1
#SBATCH --ntasks 1
#SBATCH --cpus-per-task 36
#SBATCH --mem 250GB
#SBATCH --time 12:00:00
#SBATCH --partition=standard
#SBATCH --qos=serial
#SBATCH --output /home/%u/poseforge/scripts_on_cluster/style_transfer_dataset_extraction/output_%x_%j.log

set -euo pipefail

echo "Hello from $(hostname)"

# -----------------------------------------------------------------------------
# Environment setup
# -----------------------------------------------------------------------------
. ~/spack/share/spack/setup-env.sh
spack load ffmpeg
conda activate poseforge

# -----------------------------------------------------------------------------
# Project / data paths (edit as needed)
# -----------------------------------------------------------------------------
PROJECT_ROOT="/home/$USER/poseforge"
EXTRACTION_CLI_PATH="src/poseforge/style_transfer/scripts/extract_dataset.py"

# Simulated images (generated by poseforge/neuromechfly/scripts/run_simulation.py)
NMF_RENDERING_DIR="$WORK/$USER/poseforge/data/nmf_rendering"
# Recorded images (from Spotlight)
SPOTLIGHT_RECORDINGS_DIR="$WORK/$USER/poseforge/data/spotlight_aligned_and_cropped"
# Output directory for extracted training images
OUTPUT_DIR="$WORK/$USER/poseforge/style_transfer_datasets/nmf/aymanns2022_pseudocolor_spotlight_dataset_gray"
# Name of the rendered video file inside each NMF subsegment directory
VIDEO_FILENAME="processed_nmf_sim_render_grayscale.mp4"

# Match the number of workers to the allocated CPUs
NUM_WORKERS=$SLURM_CPUS_PER_TASK

# -----------------------------------------------------------------------------
# Extract
# -----------------------------------------------------------------------------
cd "$PROJECT_ROOT"

echo "Extraction starting at $(date)"

python -u "$EXTRACTION_CLI_PATH" \
    --nmf-rendering-dir "$NMF_RENDERING_DIR" \
    --spotlight-recordings-dir "$SPOTLIGHT_RECORDINGS_DIR" \
    --output-dir "$OUTPUT_DIR" \
    --video-filename "$VIDEO_FILENAME" \
    --num-workers "$NUM_WORKERS"

echo "Extraction ends at $(date)"
