#!/bin/bash -l

#SBATCH --job-name st_dataset_extraction_multiprior
#SBATCH --nodes 1
#SBATCH --ntasks 1
#SBATCH --cpus-per-task 18
#SBATCH --mem 120GB
#SBATCH --time 10:00:00
#SBATCH --partition=standard
#SBATCH --qos=serial
#SBATCH --output /home/%u/poseforge/scripts_on_cluster/style_transfer_dataset_extraction_multiprior/output_%x_%j.log

set -euo pipefail

echo "Hello from $(hostname)"

# -----------------------------------------------------------------------------
# Environment setup
# -----------------------------------------------------------------------------
. ~/spack/share/spack/setup-env.sh
spack load ffmpeg
conda activate poseforge

# -----------------------------------------------------------------------------
# Project / data paths  --  EDIT THESE
# -----------------------------------------------------------------------------
PROJECT_ROOT="/home/$USER/poseforge"
EXTRACTION_CLI_PATH="src/poseforge/style_transfer/scripts/extract_dataset_multiprior.py"

# Simulated renders (generated by poseforge/neuromechfly/scripts/run_simulation.py).
# Each subsegment MUST contain all five geometry-buffer videos:
#   processed_nmf_sim_render_grayscale.mp4  (primary image)
#   processed_nmf_sim_render_shading.mp4
#   processed_nmf_sim_depth.mp4
#   processed_nmf_sim_normals.mp4
#   processed_nmf_sim_segment_id.mp4
# plus processed_simulation_data.h5 (for the silhouette mask). These only exist
# for renders produced after the flygym-v2 port (render_depth + shading default).
NMF_RENDERING_DIR="$WORK/$USER/poseforge/data/nmf_rendering_aymanns2022"

# Recorded images (domain B) -- output of spotlight_unpack_and_categorize.
SPOTLIGHT_RECORDINGS_DIR="$WORK/$USER/poseforge/data/spotlight_aligned_and_cropped_new"

# Output dataset directory (CUT-style trainA / trainA_<prior> / trainB layout).
OUTPUT_DIR="$WORK/$USER/poseforge/style_transfer_datasets/nmf/aymanns2022_multiprior_spotlight_dataset"

# Number of domain-A / domain-B frames drawn per split.
NUM_TRAIN_FRAMES=20000
NUM_VAL_FRAMES=100

# Match the number of workers to the allocated CPUs.
NUM_WORKERS=$SLURM_CPUS_PER_TASK

# -----------------------------------------------------------------------------
# Extract
# -----------------------------------------------------------------------------
cd "$PROJECT_ROOT"

echo "Multiprior extraction starting at $(date)"
echo "  NMF renders : ${NMF_RENDERING_DIR}"
echo "  Spotlight   : ${SPOTLIGHT_RECORDINGS_DIR}"
echo "  Output      : ${OUTPUT_DIR}"
echo "  Frames      : ${NUM_TRAIN_FRAMES} train + ${NUM_VAL_FRAMES} val per domain"
echo "  Workers     : ${NUM_WORKERS}"

python -u "$EXTRACTION_CLI_PATH" \
    --nmf-rendering-dir "$NMF_RENDERING_DIR" \
    --spotlight-recordings-dir "$SPOTLIGHT_RECORDINGS_DIR" \
    --output-dir "$OUTPUT_DIR" \
    --num-train-frames "$NUM_TRAIN_FRAMES" \
    --num-val-frames "$NUM_VAL_FRAMES" \
    --num-workers "$NUM_WORKERS"

echo "Multiprior extraction ends at $(date)"
